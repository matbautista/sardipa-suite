# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# scripts/package-release.mjs output (Section 10 phase 17) — a build
# artifact assembled from a build machine, never source content
/release

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template itself, which has no real secrets and is meant to
# be committed — the README's setup steps depend on it existing in the repo
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite dev database (Section 8: a real deployment's dev.db travels with
# that install — this is just local dev data, not something to version)
/dev.db
/dev.db-journal
/*.db
/*.db-journal
# WAL mode (Section 9) sidecar files
/*.db-wal
/*.db-shm

# local dev document storage location (seed script only — a real deployment's
# storage location lives on a separate disk, well outside the repo)
/dev-storage

# Prisma CLI's per-machine agent-skill reference docs (regenerated by
# `prisma init`/`prisma generate`, not project content)
/.agents/
/.claude/skills/
/.windsurf/
/skills-lock.json

# Claude Code local settings (personal, not shared)
/.claude/settings.local.json
