# Copy this file to .env and adjust as needed.

# SQLite database file (Section 7 of the plan — lives inside the app folder,
# never on a network share)
DATABASE_URL="file:./dev.db"

# Signs/encrypts the NextAuth JWT session cookie. Generate a real one with
# `openssl rand -base64 32` (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
# — never reuse the same value across environments.
AUTH_SECRET=""

# Process supervisor tuning (scripts/watchdog.mjs) — all optional, sensible
# defaults built in. See that file's DEFAULTS block for the full list
# (health check interval/URL, failure window, restart-loop threshold, etc.)
# and Section 9 of the plan for the reasoning behind the default values.
# WATCHDOG_HEALTH_CHECK_FAIL_WINDOW_MS=75000
# WATCHDOG_RESTART_LOOP_THRESHOLD=3

# Proactive storage-location monitoring (src/lib/storage-health.ts) — all
# optional, sensible defaults built in (500MB free / 90% used, checked
# every 5 minutes). See Section 9 of the plan.
# STORAGE_LOW_SPACE_THRESHOLD_BYTES=524288000
# STORAGE_LOW_SPACE_USED_PERCENT=90
# STORAGE_HEALTH_CHECK_INTERVAL_MS=300000
